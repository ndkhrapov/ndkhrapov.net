https://me.ndkhrapov.net {
	import website_tls
	import website_headers
	import website_errors
	route {
		header Cache-Control no-cache
		@profile_documents path / /index.html /ru.html
		header @profile_documents Cache-Control "no-cache, no-transform"
		encode zstd gzip

		@links_alias path /links/ /links/index.html
		redir @links_alias /links 308
		@links path /links /links/directory.css /links/appearance.js
		handle @links {
			rewrite /links /links/index.html
			file_server {
				root /srv
			}
		}

		@gravatar path /header.webp /profile.webp /gravatar.css
		@unexpected not path / /index.html /ru.html /styles.css /profile.js /favicon.svg /header.webp /profile.webp /gravatar.css
		error @unexpected 404
		file_server @gravatar {
			root /srv/.gravatar/current
			pass_thru
		}
		file_server {
			root /srv/me
		}
	}
}

https://links.ndkhrapov.net {
	import website_tls
	import website_headers
	import website_errors
	@directory path / /links /links/ /links/index.html
	redir @directory https://me.ndkhrapov.net/links 308
	@assets path /links/directory.css /links/appearance.js /favicon.svg
	redir @assets https://me.ndkhrapov.net{uri} 308
	error 404
}
