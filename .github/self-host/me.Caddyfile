https://me.ndkhrapov.net {
	import website_tls
	import website_headers
	import website_errors
	route {
		header Cache-Control no-cache
		@profile_documents path /landing/en /landing/links/en
		header @profile_documents Cache-Control "no-cache, no-transform"
		encode zstd gzip

		@profile_alias path / /index.html /landing /landing/ /ru.html /landing/ru
		redir @profile_alias /landing/en 308
		@links_alias path /links /links/ /links/index.html /landing/links/ru
		redir @links_alias /landing/links/en 308
		@links path /links/directory.html /links/directory.css /links/appearance.js
		handle @links {
			rewrite /links/directory.html /links/index.html
			file_server {
				root /srv
			}
		}

		@english path /landing/en /landing/links/en
		rewrite @english /index.html

		@gravatar path /header.webp /profile.webp /gravatar.css
		@unexpected not path /index.html /styles.css /profile.js /favicon.svg /header.webp /profile.webp /gravatar.css
		error @unexpected 404
		file_server @gravatar {
			root /srv/.gravatar/current
			pass_thru
		}
		file_server {
			root /srv/me
		}
	}
}

https://links.ndkhrapov.net {
	import website_tls
	import website_headers
	import website_errors
	@directory path / /links /links/ /links/index.html
	redir @directory https://me.ndkhrapov.net/landing/links/en 308
	@assets path /links/directory.css /links/appearance.js /favicon.svg
	redir @assets https://me.ndkhrapov.net{uri} 308
	error 404
}
