# Import this snippet in the apex HTTPS site to preserve old directory URLs.
(profile_links_redirect) {
	@profile_links path /links /links/ /links/index.html /links/directory.html
	redir @profile_links "https://me.ndkhrapov.net/#links" 308
}

https://me.ndkhrapov.net {
	import website_tls
	import website_headers
	import website_errors
	route {
		header Cache-Control no-cache
		@profile_documents path /
		header @profile_documents Cache-Control "no-cache, no-transform"
		encode zstd gzip

		@profile_alias path /index.html /landing /landing/ /landing/en /ru.html /landing/ru
		redir @profile_alias / 308
		@links_alias path /links /links/ /links/index.html /links/directory.html /landing/links/en /landing/links/ru
		redir @links_alias "/#links" 308

		@gravatar path /header.webp /profile.webp /gravatar.css
		@unexpected not path / /styles.css /profile.js /favicon.svg /header.webp /profile.webp /gravatar.css
		error @unexpected 404
		file_server @gravatar {
			root /srv/.gravatar/current
			pass_thru
		}
		file_server {
			root /srv/me
		}
	}
}

https://links.ndkhrapov.net {
	import website_tls
	import website_headers
	import website_errors
	redir / "https://me.ndkhrapov.net/#links" 308
	import profile_links_redirect
	error 404
}
